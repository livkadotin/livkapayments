# Database Connection (PostgreSQL for Production, or SQLite for local dev)
# For production (Vercel, Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/replyflowpay?schema=public"
# For local zero-setup dev:
DATABASE_URL="file:./dev.db"

# Razorpay Merchant Credentials (One Central Account for Livka Pay)
# If left empty or as test dummy, Livka Pay's built-in simulation adapter will allow end-to-end local testing.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Public Platform URL
APP_URL="https://payments.livka.in"
NEXT_PUBLIC_APP_URL="https://payments.livka.in"

# JWT Authentication Secret (Used for Admin Sessions)
AUTH_SECRET="replyflow_pay_super_secret_jwt_key_at_least_32_characters_long"

# Default Admin Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@livka.in"
ADMIN_DEFAULT_PASSWORD="admin_livka_2026"
